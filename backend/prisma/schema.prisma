generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int              @id @default(autoincrement())
  telegramId    BigInt           @unique
  firstName     String?
  lastName      String?
  username      String?
  createdAt     DateTime         @default(now())
  habits        Habit[]
  events        AnalyticsEvent[]
  foods         Food[]
  foodLog       FoodLogEntry[]
  weights       WeightEntry[]
  nutritionGoal NutritionGoal?
  favorites     FavoriteFood[]
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  userId    Int?
  event     String
  category  String
  label     String?
  metadata  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@index([event, createdAt])
}

model Habit {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String       @default("#4CAF50")
  icon      String?
  createdAt DateTime     @default(now())
  archived  Boolean      @default(false)
  binary    Boolean      @default(false)
  /// null = intensity levels 1-4 (or done/not done when binary); "hours" = entry value is minutes
  measure   String?
  entries   HabitEntry[]
  reminder  Reminder?

  @@index([userId])
}

model Reminder {
  id            Int       @id @default(autoincrement())
  habitId       Int       @unique
  habit         Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(true)
  days          String    @default("[\"mon\",\"tue\",\"wed\",\"thu\",\"fri\",\"sat\",\"sun\"]")
  time          String    @default("09:00")
  snooze        Boolean   @default(false)
  lastMessageId Int?
  lastSentAt    DateTime?
  createdAt     DateTime  @default(now())
}

model HabitEntry {
  id        Int      @id @default(autoincrement())
  habitId   Int
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  value     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId, date])
}

// ─── Nutrition module ─────────────────────────────────────────────────────────

/// Food catalog: seed base + user's own products + cached Open Food Facts / LLM results.
/// Nutrients are per 100 g.
model Food {
  id          Int            @id @default(autoincrement())
  ownerId     Int?
  owner       User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  searchName  String
  brand       String?
  source      String
  sourceUrl   String?
  externalId  String?
  kcal        Float
  protein     Float
  fat         Float
  carbs       Float
  servings    String?
  usageCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  logEntries  FoodLogEntry[]
  favoritedBy FavoriteFood[]

  @@unique([source, externalId])
  @@index([searchName])
  @@index([ownerId])
}

/// One eaten item. Nutrients are a snapshot already scaled to `grams`.
model FoodLogEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  meal      String
  foodId    Int?
  food      Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name      String
  grams     Float
  kcal      Float
  protein   Float
  fat       Float
  carbs     Float
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model NutritionGoal {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kcal            Int
  protein         Int?
  fat             Int?
  carbs           Int?
  startWeightKg   Float?
  targetWeightKg  Float?
  targetDate      DateTime?
  /// Habits that feed the model: training days (done/not done) and sleep (hours)
  trainingHabitId Int?
  sleepHabitId    Int?
  updatedAt       DateTime  @updatedAt
}

model WeightEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  weightKg  Float
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

/// Foods a user starred — any visible food (own, imported, seed, OFF cache).
model FavoriteFood {
  userId    Int
  foodId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
}
