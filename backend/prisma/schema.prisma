generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int              @id @default(autoincrement())
  telegramId    BigInt           @unique
  firstName     String?
  lastName      String?
  username      String?
  createdAt     DateTime         @default(now())
  /// Minutes, JS getTimezoneOffset() convention (UTC − local): Moscow = −180. Sent by the client on auth.
  tzOffset      Int?
  /// Local 'HH:MM' of the evening check-in.
  checkinTime   String?
  /// Local 'YYYY-MM-DD' of the last evening check-in sent (or skipped because everything was marked).
  lastCheckinDate String?
  /// Local 'HH:MM' of the optional morning check-in (morning habits only); null = off.
  morningCheckinTime String?
  /// Local 'YYYY-MM-DD' of the last morning check-in sent (or skipped).
  lastMorningCheckinDate String?
  onboardedAt   DateTime?
  /// Can the bot message this user? null = unknown, true = allowed (initData allows_write_to_pm, /start, a
  /// successful send), false = the last send got 403 (never pressed /start, or blocked the bot).
  canMessage    Boolean?
  /// Who invited this user (User.id from `ref_<id>` in start_param / the /start payload). Set once, on registration.
  referrerId    Int?
  habits        Habit[]
  events        AnalyticsEvent[]
  foods         Food[]
  foodLog       FoodLogEntry[]
  weights       WeightEntry[]
  nutritionGoal NutritionGoal?
  favorites     FavoriteFood[]
  dayMarks      DayMark[]
  mealTemplates MealTemplate[]

  @@index([referrerId])
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  userId    Int?
  event     String
  category  String
  label     String?
  metadata  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@index([event, createdAt])
}

model Habit {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String       @default("#4CAF50")
  icon      String?
  createdAt DateTime     @default(now())
  archived  Boolean      @default(false)
  binary    Boolean      @default(false)
  /// null = intensity levels 1-4 (or done/not done when binary); "hours" = entry value is minutes;
  /// "count" = entry value is how many (0-999), done when value >= dailyTarget
  measure   String?
  /// null = every day; 1-6 = N times a week (frequency goal, drives weekly progress)
  weeklyTarget Int?
  /// "morning" | "day" | "evening"; null = any time (section on the Today screen, check-in order)
  timeOfDay String?
  /// count habits only: how many per day makes the day done (1-99)
  dailyTarget Int?
  /// manual order (ascending), then createdAt
  sortOrder Int          @default(0)
  /// Challenge: reach this many done days (3-365) counting from `challengeStart`; null = not a challenge.
  challengeDays  Int?
  /// Local 'YYYY-MM-DD' the challenge started; set together with challengeDays.
  challengeStart String?
  entries   HabitEntry[]
  reminder  Reminder?

  @@index([userId])
}

model Reminder {
  id            Int       @id @default(autoincrement())
  habitId       Int       @unique
  habit         Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  enabled       Boolean   @default(true)
  days          String    @default("[\"mon\",\"tue\",\"wed\",\"thu\",\"fri\",\"sat\",\"sun\"]")
  time          String    @default("09:00")
  snooze        Boolean   @default(false)
  lastMessageId Int?
  lastSentAt    DateTime?
  createdAt     DateTime  @default(now())
}

model HabitEntry {
  id        Int      @id @default(autoincrement())
  habitId   Int
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  value     Int      @default(1)
  /// Day off (sick / vacation): value is 0, not done, and transparent for streaks.
  skipped   Boolean  @default(false)
  /// Sleep (hours habits): local bed / wake time "HH:MM"; value = minutes between them. The night belongs to the wake date.
  startTime String?
  endTime   String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([habitId, date])
}

// ─── Nutrition module ─────────────────────────────────────────────────────────

/// Food catalog: seed base + user's own products + cached Open Food Facts / LLM results.
/// Nutrients are per 100 g.
model Food {
  id          Int            @id @default(autoincrement())
  ownerId     Int?
  owner       User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  searchName  String
  brand       String?
  source      String
  sourceUrl   String?
  externalId  String?
  kcal        Float
  protein     Float
  fat         Float
  carbs       Float
  servings    String?
  usageCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  logEntries  FoodLogEntry[]
  favoritedBy FavoriteFood[]

  @@unique([source, externalId])
  @@index([searchName])
  @@index([ownerId])
}

/// One eaten item. Nutrients are a snapshot already scaled to `grams`.
model FoodLogEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  meal      String
  foodId    Int?
  food      Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name      String
  grams     Float
  kcal      Float
  protein   Float
  fat       Float
  carbs     Float
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model NutritionGoal {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kcal            Int
  protein         Int?
  fat             Int?
  carbs           Int?
  startWeightKg   Float?
  targetWeightKg  Float?
  targetDate      DateTime?
  /// Habits that feed the model: training days (done/not done) and sleep (hours)
  trainingHabitId Int?
  sleepHabitId    Int?
  /// Protein target as g per kg of the weight trend; null = manual `protein` (or 1.8 g/kg default)
  proteinPerKg    Float?
  /// JSON GoalPhase[] ({type: bulk|cut|maintain, until: YYYY-MM-DD, targetWeightKg?, rateKgPerWeek?}), ordered by `until`
  phases          String?
  updatedAt       DateTime  @updatedAt
}

model WeightEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  weightKg  Float
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

/// Foods a user starred — any visible food (own, imported, seed, OFF cache).
model FavoriteFood {
  userId    Int
  foodId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
}

/// "День заполнен полностью" — the user's explicit mark; the model trusts it over its heuristic.
model DayMark {
  userId    Int
  date      DateTime
  complete  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

/// A saved set of foods added in one tap («Мой завтрак»). Macros come from the foods at apply time.
model MealTemplate {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Suggested meal slot; null = any.
  meal      String?
  /// JSON [{ "foodId": number, "grams": number }]
  items     String
  createdAt DateTime @default(now())

  @@index([userId])
}
